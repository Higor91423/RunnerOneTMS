NODE_ENV=development
PORT=3333

# Banco de Dados PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=root
DB_NAME=runner_one_db

# Segurança e Autenticação
JWT_SECRET=substitua_por_uma_chave_secreta_longa_e_aleatoria
JWT_EXPIRES_IN=8h

# Controle de Cadastro Público (true = qualquer visitante cria conta como OPERADOR | false = somente ADMIN cria contas)
ALLOW_PUBLIC_REGISTRATION=true